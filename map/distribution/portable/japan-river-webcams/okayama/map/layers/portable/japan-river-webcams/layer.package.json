{
  "id": "japan-river-webcams",
  "title": "全国河川監視カメラ",
  "type": "svgmap-portable-layer",
  "entrypoint": "webcamLayer.svg",
  "portability": {
    "level": "distribution-portable",
    "dataInjection": "hash-params",
    "limitations": [
      "Stock SVGMap does not auto-launch svg3-postmessage-adapter; use the declared hostBridge."
    ]
  },
  "runtime": {
    "lawaModes": [
      "tight"
    ],
    "readyEvent": "layerWebAppReady",
    "requiredApis": [
      "svgMap.getGeoViewBox",
      "svgMap.setShowPoiProperty",
      "svgMap.showModal",
      "svgImage"
    ]
  },
  "runtimeDependencies": [
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "../representative-pins/runtime.package.json"
    },
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "../isolated-runtime/runtime.package.json"
    }
  ],
  "isolated": {
    "kind": "svg3-postmessage-adapter",
    "layerEntrypoint": "../isolated-runtime/isolatedLayer.svg",
    "controllerEntrypoint": "../isolated-runtime/isolatedLayerController.html",
    "hostBridge": "../isolated-runtime/isolatedLayerHost.js",
    "protocol": "svgmap-isolated-layer@1",
    "render": {
      "defaultStatus": "available",
      "icons": {
        "available": "../../../icons/river-webcam.svg",
        "unknown": "../../../icons/river-webcam.svg"
      }
    },
    "detail": {
      "rows": [
        {
          "field": "location",
          "label": "設置場所"
        },
        {
          "field": "river",
          "label": "河川"
        },
        {
          "field": "provider",
          "label": "提供元"
        }
      ],
      "media": [
        {
          "field": "imageUrl",
          "label": "カメラ画像",
          "type": "image",
          "refreshCooldownMs": 10000
        }
      ],
      "links": [
        {
          "field": "pageUrl",
          "label": "公式ページ"
        }
      ]
    },
    "security": {
      "imageHosts": [
        "cam.river.go.jp",
        "www.river.go.jp"
      ],
      "linkHosts": [
        "www.river.go.jp"
      ]
    }
  },
  "shared": [
    "webcamDetail.js"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": [
        "data",
        "layer"
      ],
      "optional": [
        "summary",
        "statusOverlay",
        "profile",
        "municipalityCodes",
        "districtSvgUrlTemplate"
      ]
    },
    "summary": "../../../data/qtct/japanRiverWebcam/okayama/summary.json",
    "detail": "../../../data/qtct/japanRiverWebcam/okayama/detail.json",
    "regionId": "okayama"
  },
  "runtimeDependencyLock": [
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "isolated-runtime/runtime.package.json",
      "integrity": "sha256-bb70dc9c885c731913dd73eb00d379f6326cfab22dab89c72d40c185de51aa86"
    },
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "representative-pins/runtime.package.json",
      "integrity": "sha256-5f15b2559e3edd92db4e3e91a2b2438b7b9b00a73ece7b0919ae3ac4d2d434ce"
    }
  ]
}
