{
  "id": "roadClosure",
  "title": "Road Closure Portable Layer",
  "version": "1.0.0",
  "type": "svgmap-portable-layer",
  "entrypoint": "roadClosureLayer.svg",
  "portability": {
    "level": "distribution-portable",
    "dataInjection": "hash-params",
    "limitations": [
      "Stock SVGMap does not auto-launch svg3-postmessage-adapter; use the declared hostBridge."
    ]
  },
  "runtime": {
    "lawaModes": [
      "tight"
    ],
    "readyEvent": "layerWebAppReady",
    "requiredApis": [
      "svgMap.getGeoViewBox",
      "svgMap.setShowPoiProperty",
      "svgMap.showModal",
      "svgImage"
    ]
  },
  "runtimeDependencies": [
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "../representative-pins/runtime.package.json"
    },
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "../isolated-runtime/runtime.package.json"
    }
  ],
  "detailMode": "svgMap.showModal",
  "isolated": {
    "kind": "svg3-postmessage-adapter",
    "layerEntrypoint": "../isolated-runtime/isolatedLayer.svg",
    "controllerEntrypoint": "../isolated-runtime/isolatedLayerController.html",
    "hostBridge": "../isolated-runtime/isolatedLayerHost.js",
    "protocol": "svgmap-isolated-layer@1",
    "render": {
      "defaultStatus": "unknown",
      "icons": {
        "closed": "../../../icons/road-closure-closed.svg",
        "flooded": "../../../icons/road-closure-flooded.svg",
        "restricted": "../../../icons/road-closure-restricted.svg",
        "cleared": "../../../icons/road-closure-cleared.svg",
        "unknown": "../../../icons/road-closure-unknown.svg"
      }
    },
    "detail": {
      "rows": [
        {
          "property": "roadName",
          "label": "道路名"
        },
        {
          "property": "section",
          "label": "区間"
        },
        {
          "property": "reason",
          "label": "原因"
        },
        {
          "property": "startedAt",
          "label": "開始"
        },
        {
          "property": "updatedAt",
          "label": "更新"
        },
        {
          "property": "reporter",
          "label": "確認者"
        },
        {
          "property": "note",
          "label": "備考"
        },
        {
          "property": "sourceUrl",
          "label": "情報元"
        }
      ]
    }
  },
  "capabilities": [
    "feature-detail",
    "qtct",
    "status-icons"
  ],
  "shared": [
    "roadClosureDetail.js"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": [
        "data",
        "layer"
      ],
      "optional": [
        "summary",
        "statusOverlay",
        "profile",
        "municipalityCodes",
        "districtSvgUrlTemplate"
      ]
    },
    "summary": "../../../data/qtct/roadClosure/okayama/summary.json",
    "detail": "../../../data/qtct/roadClosure/okayama/detail.json",
    "regionId": "okayama"
  },
  "runtimeDependencyLock": [
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "isolated-runtime/runtime.package.json",
      "integrity": "sha256-bb70dc9c885c731913dd73eb00d379f6326cfab22dab89c72d40c185de51aa86"
    },
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "representative-pins/runtime.package.json",
      "integrity": "sha256-5f15b2559e3edd92db4e3e91a2b2438b7b9b00a73ece7b0919ae3ac4d2d434ce"
    }
  ]
}
