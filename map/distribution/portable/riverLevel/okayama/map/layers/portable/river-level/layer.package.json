{
  "id": "riverLevel",
  "title": "River Level Portable Layer",
  "version": "1.0.0",
  "type": "svgmap-portable-layer",
  "entrypoint": "riverLevelLayer.svg",
  "portability": {
    "level": "distribution-portable",
    "dataInjection": "hash-params",
    "limitations": [
      "Stock SVGMap does not auto-launch svg3-postmessage-adapter; use the declared hostBridge."
    ]
  },
  "runtime": {
    "lawaModes": [
      "tight"
    ],
    "readyEvent": "layerWebAppReady",
    "requiredApis": [
      "svgMap.getGeoViewBox",
      "svgMap.setShowPoiProperty",
      "svgMap.showModal",
      "svgImage"
    ]
  },
  "runtimeDependencies": [
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "../representative-pins/runtime.package.json"
    },
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "../isolated-runtime/runtime.package.json"
    }
  ],
  "detailMode": "svgMap.showModal",
  "isolated": {
    "kind": "svg3-postmessage-adapter",
    "layerEntrypoint": "../isolated-runtime/isolatedLayer.svg",
    "controllerEntrypoint": "../isolated-runtime/isolatedLayerController.html",
    "hostBridge": "../isolated-runtime/isolatedLayerHost.js",
    "protocol": "svgmap-isolated-layer@1",
    "render": {
      "defaultStatus": "unknown",
      "icons": {
        "normal": "../../../icons/river-level-normal.svg",
        "advisory": "../../../icons/river-level-advisory.svg",
        "evacuation": "../../../icons/river-level-evacuation.svg",
        "danger": "../../../icons/river-level-danger.svg",
        "stale": "../../../icons/river-level-stale.svg",
        "unknown": "../../../icons/river-level-unknown.svg"
      }
    },
    "detail": {
      "rows": [
        {
          "property": "river",
          "label": "河川"
        },
        {
          "property": "location",
          "label": "設置場所"
        },
        {
          "property": "currentLevel",
          "label": "現在水位",
          "unitProperty": "unit"
        },
        {
          "property": "change1h",
          "label": "1時間変化",
          "unitProperty": "unit"
        },
        {
          "property": "advisoryLevel",
          "label": "氾濫注意水位",
          "unitProperty": "unit"
        },
        {
          "property": "evacuationLevel",
          "label": "避難判断水位",
          "unitProperty": "unit"
        },
        {
          "property": "dangerLevel",
          "label": "氾濫危険水位",
          "unitProperty": "unit"
        },
        {
          "property": "observedAt",
          "label": "観測時刻"
        },
        {
          "property": "quality",
          "label": "データ状態"
        },
        {
          "property": "sourceUrl",
          "label": "公式ページ"
        }
      ]
    }
  },
  "capabilities": [
    "feature-detail",
    "qtct",
    "status-icons"
  ],
  "shared": [
    "riverLevelDetail.js"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": [
        "data",
        "layer"
      ],
      "optional": [
        "summary",
        "statusOverlay",
        "profile",
        "municipalityCodes",
        "districtSvgUrlTemplate"
      ]
    },
    "summary": "../../../data/qtct/riverLevel/okayama/summary.json",
    "detail": "../../../data/qtct/riverLevel/okayama/detail.json",
    "regionId": "okayama"
  },
  "runtimeDependencyLock": [
    {
      "id": "isolated-runtime",
      "version": "1.0.0",
      "manifest": "isolated-runtime/runtime.package.json",
      "integrity": "sha256-bb70dc9c885c731913dd73eb00d379f6326cfab22dab89c72d40c185de51aa86"
    },
    {
      "id": "representative-pins",
      "version": "1.0.0",
      "manifest": "representative-pins/runtime.package.json",
      "integrity": "sha256-5f15b2559e3edd92db4e3e91a2b2438b7b9b00a73ece7b0919ae3ac4d2d434ce"
    }
  ]
}
