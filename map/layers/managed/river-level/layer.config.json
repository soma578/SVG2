      "location": { "column": "location", "type": "string" },
      "currentLevel": { "column": "currentLevel", "type": "number" },
      "change1h": { "column": "change1h", "type": "number" },
      "advisoryLevel": { "column": "advisoryLevel", "type": "number" },
      "evacuationLevel": { "column": "evacuationLevel", "type": "number" },
      "dangerLevel": { "column": "dangerLevel", "type": "number" },
      "unit": { "column": "unit", "type": "string" },
      "observedAt": { "column": "observedAt", "type": "string" },
      "sourceUrl": { "column": "sourceUrl", "type": "string" },
      "quality": { "column": "quality", "type": "string" }
    }
  }
