{
  "id": "roadClosure",
  "title": "Road Closure Portable Layer",
  "version": "1.0.0",
  "type": "svgmap-portable-layer",
  "entrypoint": "roadClosureLayer.svg",
  "portability": {
    "level": "workspace-portable",
    "dataInjection": "hash-params",
    "limitations": ["package-external-shared-core"]
  },
  "runtime": {
    "lawaModes": ["tight"],
    "readyEvent": "layerWebAppReady",
    "requiredApis": ["svgMap.getGeoViewBox", "svgMap.setShowPoiProperty", "svgMap.showModal", "svgImage"]
  },
  "runtimeDependencies": [
    { "id": "representative-pins", "version": "1.0.0", "manifest": "../representative-pins/runtime.package.json" },
    { "id": "isolated-runtime", "version": "1.0.0", "manifest": "../isolated-runtime/runtime.package.json" }
  ],
  "detailMode": "svgMap.showModal",
  "isolated": {
    "kind": "svg3-postmessage-adapter",
    "layerEntrypoint": "../isolated-runtime/isolatedLayer.svg",
    "controllerEntrypoint": "../isolated-runtime/isolatedLayerController.html",
    "hostBridge": "../isolated-runtime/isolatedLayerHost.js",
    "protocol": "svgmap-isolated-layer@1",
    "render": {
      "defaultStatus": "unknown",
      "icons": {
        "closed": "../../../icons/road-closure-closed.svg",
        "flooded": "../../../icons/road-closure-flooded.svg",
        "restricted": "../../../icons/road-closure-restricted.svg",
        "cleared": "../../../icons/road-closure-cleared.svg",
        "unknown": "../../../icons/road-closure-unknown.svg"
      }
    },
    "detail": {
      "rows": [
        { "property": "roadName", "label": "道路名" },
        { "property": "section", "label": "区間" },
        { "property": "reason", "label": "原因" },
        { "property": "startedAt", "label": "開始" },
        { "property": "updatedAt", "label": "更新" },
        { "property": "reporter", "label": "確認者" },
        { "property": "note", "label": "備考" },
        { "property": "sourceUrl", "label": "情報元" }
      ]
    }
  },
  "capabilities": [
    "feature-detail",
    "qtct",
    "status-icons"
  ],
  "shared": [
    "roadClosureDetail.js"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": ["data", "layer"],
      "optional": ["summary", "statusOverlay", "profile", "municipalityCodes", "districtSvgUrlTemplate"]
    }
  }
}
