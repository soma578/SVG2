{
  "id": "teamActivity",
  "title": "Team Activity Portable Layer",
  "entrypoint": "teamActivityLayer.svg",
  "adminEntrypoint": "admin.html",
  "type": "svgmap-portable-layer",
  "portability": {
    "level": "workspace-portable",
    "dataInjection": "hash-params",
    "limitations": ["package-external-shared-core", "admin-runtime-mixed"]
  },
  "runtime": {
    "lawaModes": ["tight"],
    "readyEvent": "layerWebAppReady",
    "requiredApis": ["svgMap.getGeoViewBox", "svgMap.setShowPoiProperty", "svgMap.showModal", "svgImage"]
  },
  "runtimeDependencies": [
    { "id": "representative-pins", "version": "1.0.0", "manifest": "../representative-pins/runtime.package.json" },
    { "id": "isolated-runtime", "version": "1.0.0", "manifest": "../isolated-runtime/runtime.package.json" }
  ],
  "detailMode": "svgMap.showModal",
  "isolated": {
    "kind": "svg3-postmessage-adapter",
    "layerEntrypoint": "../isolated-runtime/isolatedLayer.svg",
    "controllerEntrypoint": "../isolated-runtime/isolatedLayerController.html",
    "hostBridge": "../isolated-runtime/isolatedLayerHost.js",
    "protocol": "svgmap-isolated-layer@1",
    "render": {
      "defaultStatus": "active",
      "icons": {
        "active": "../../../icons/team-active.png",
        "limited": "../../../icons/team-active.png",
        "full": "../../../icons/team-active.png",
        "standby": "../../../icons/team-standby.png",
        "planned": "../../../icons/team-planned.png",
        "completed": "../../../icons/team-completed.png",
        "needs_attention": "../../../icons/team-attention.png",
        "unknown": "../../../icons/team-attention.png"
      }
    },
    "detail": {
      "rows": [
        { "field": "summary", "label": "活動概要" },
        { "field": "area", "label": "担当地区" },
        { "field": "operator", "label": "運営者" },
        { "field": "municipalityCode", "label": "自治体コード" }
      ]
    }
  },
  "shared": [
    "teamActivityDetail.js",
    "teamActivityAreaLayer.svg",
    "teamActivityAreaLayer.html",
    "publication.json"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": ["data", "layer"],
      "optional": ["summary", "statusOverlay", "profile", "municipalityCodes", "districtSvgUrlTemplate"]
    }
  },
  "containerAnimation": {
    "class": "poi clickable",
    "visibility": "hidden",
    "opacity": "1"
  }
}
