{
  "name": "svg3-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:district-svgs": "python3 scripts/generate-district-svgs.py",
    "generate:representative-qtct": "node scripts/generate-representative-qtct.mjs",
    "generate:okayama-webcams": "node scripts/generate-okayama-webcam-layer.mjs",
    "generate:river-webcams": "node scripts/generate-okayama-webcam-layer.mjs",
    "webcams:cache": "node scripts/cache-webcam-images.mjs",
    "layers:check": "node scripts/check-layer-configs.mjs",
    "layers:build": "node scripts/generate-layer-assets.mjs",
    "containers:generate": "node scripts/generate-denshi-containers.mjs",
    "assets:prepare": "node scripts/prepare-public-assets.mjs",
    "assets:check": "node scripts/check-public-assets.mjs",
    "containers:check": "node scripts/check-containers.mjs",
    "runtime-import:check": "node scripts/check-runtime-layer-importer.mjs",
    "native-poi:check": "node scripts/check-native-poi-refresh.mjs",
    "native-data:check": "node scripts/check-native-data-budget.mjs",
    "native-host:check": "node scripts/check-native-host-contract.mjs",
    "pipeline:check": "node scripts/check-generated-pipeline.mjs",
    "portable:check": "node scripts/check-portable-layers.mjs",
    "portable:bundle": "node scripts/build-portable-bundles.mjs",
    "portable:bundle:check": "node scripts/check-portable-bundles.mjs",
    "portable:bundle:e2e": "playwright test --config playwright.portable.config.mjs",
    "map:build": "node ../scripts/extract_evacuation_svg_data.mjs && npm run generate:district-svgs && npm run generate:representative-qtct && npm run layers:check && npm run layers:build && npm run containers:generate && npm run portable:check && npm run portable:bundle && npm run portable:bundle:check && npm run runtime-import:check && npm run native-poi:check && npm run native-host:check && npm run native-data:check && npm run pipeline:check && npm run assets:prepare && npm run assets:check && npm run containers:check",
    "predev": "npm run assets:prepare -- --if-missing && npm run assets:check",
    "dev": "next dev",
    "prebuild": "npm run map:build",
    "build": "next build && node scripts/check-public-assets.mjs",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "import:supabase": "tsx --env-file=.env.local scripts/import-supabase.ts",
    "publish:supabase": "tsx --env-file=.env.local scripts/publish-supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "next": "^16.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
