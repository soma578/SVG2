{
  "name": "okayama-disaster-map-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "prepare:public-assets": "node scripts/prepare-public-assets.mjs",
    "predev": "npm run prepare:public-assets",
    "prebuild": "npm run prepare:public-assets",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:clean": "npm run clean && next dev --webpack",
    "check:svg-normalization": "python3 ../map/tools/validate_normalized_svg.py",
    "build": "npm run check:svg-normalization && next build",
    "build:search-index": "node scripts/build-search-index.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "setup": "npm install && npm run prepare:public-assets",
    "setup:symlinks": "npm run prepare:public-assets"
  },
  "dependencies": {
    "@types/supercluster": "^7.1.3",
    "@vercel/kv": "^2.0.0",
    "cheerio": "^1.1.2",
    "iconv-lite": "^0.7.0",
    "maplibre-gl": "^5.15.0",
    "next": "^16.2.1",
    "package.json": "^0.0.0",
    "pmtiles": "^4.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-map-gl": "^8.1.0",
    "supercluster": "^8.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
