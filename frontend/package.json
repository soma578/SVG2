{
  "name": "svg3-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:district-svgs": "python3 scripts/generate-district-svgs.py",
    "predev": "node ../scripts/extract_evacuation_svg_data.mjs && python3 scripts/generate-district-svgs.py && node scripts/prepare-public-assets.mjs && node scripts/check-public-assets.mjs",
    "dev": "next dev",
    "prebuild": "node ../scripts/extract_evacuation_svg_data.mjs && python3 scripts/generate-district-svgs.py && node scripts/prepare-public-assets.mjs && node scripts/check-public-assets.mjs",
    "build": "next build && node scripts/check-public-assets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "import:supabase": "tsx --env-file=.env.local scripts/import-supabase.ts",
    "publish:supabase": "tsx --env-file=.env.local scripts/publish-supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "next": "^16.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
