# Next.js環境変数の例
# 実際の値は .env.local に設定してください

# アプリケーションURL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SVGMap関連パス（必要に応じて調整）
NEXT_PUBLIC_SVGMAP_PATH=/map

# 管理画面の認証（MVP版では簡易実装）
# TODO: 本番環境では適切な認証システムに置き換える
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 停電情報のキャッシュ時間（ミリ秒）
# デフォルト: 300000（5分）
# 中国電力のサーバー負荷を軽減するため、適切な値に設定してください
OUTAGE_CACHE_DURATION=300000
