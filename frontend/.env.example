NEXT_PUBLIC_TILE_BASE_URL=https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png

# 詳細マップで vector basemap を使う場合は vector に切り替える
NEXT_PUBLIC_DETAIL_BASEMAP_MODE=raster

# PMTiles 例:
# NEXT_PUBLIC_DETAIL_VECTOR_SOURCE_TYPE=pmtiles
# NEXT_PUBLIC_DETAIL_VECTOR_SOURCE_URL=/tiles/detail_basemap.pmtiles

# MVT テンプレート URL 例:
# NEXT_PUBLIC_DETAIL_VECTOR_SOURCE_TYPE=tiles
# NEXT_PUBLIC_DETAIL_VECTOR_SOURCE_URL=https://example.com/tiles/{z}/{x}/{y}.pbf

# OpenMapTiles 系の source-layer 名に合わせる
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_LANDCOVER=landcover
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_WATER=water
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_WATERWAY=waterway
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_ROAD=transportation
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_BOUNDARY=boundary
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_BUILDING=building
# NEXT_PUBLIC_DETAIL_VECTOR_LAYER_PLACE=place
