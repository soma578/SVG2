+
+/* ── Unified top-bar breadcrumbs ───────────────── */
+.topBarTrail {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.65rem;
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.topBarCrumb {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.42rem;
+  min-height: 2.65rem;
+  padding: 0.56rem 1.25rem;
+  border: 1px solid rgba(255, 255, 255, 0.28);
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.12);
+  color: #ffffff;
+  font-size: 0.92rem;
+  font-weight: 900;
+  white-space: nowrap;
+  cursor: pointer;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
+  backdrop-filter: blur(10px);
+}
+
+.topBarCrumb:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.2);
+}
+
+.topBarCrumb:disabled {
+  cursor: default;
+  opacity: 1;
+  background: rgba(255, 255, 255, 0.20);
+}
+
+.topBarCrumbSep {
+  color: rgba(255, 255, 255, 0.86);
+  font-size: 1.7rem;
+  font-weight: 900;
+  line-height: 1;
+}
+
+/* ── Map controls moved from top bar to map canvas ─ */
+.mapControls {
+  position: absolute;
+  right: 28.9rem;
+  bottom: 2.35rem;
+  z-index: 5;
+  display: flex;
+  flex-direction: column;
+  gap: 0.55rem;
+}
+
+.mapControlButton {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 3.15rem;
+  height: 3.15rem;
+  border: 0;
+  border-radius: 0.82rem;
+  background: rgba(255, 255, 255, 0.96);
+  color: #0b4bd8;
+  font-size: 1.55rem;
+  font-weight: 900;
+  line-height: 1;
+  cursor: pointer;
+  box-shadow:
+    0 10px 24px rgba(15, 23, 42, 0.16),
+    inset 0 1px 0 rgba(255, 255, 255, 0.92);
+}
+
+.mapControlButton:hover:not(:disabled) {
+  background: #ffffff;
+  transform: translateY(-1px);
+}
+
+.mapControlButton:active:not(:disabled) {
+  transform: translateY(0);
+}
+
+.mapControlButton:disabled {
+  opacity: 0.52;
+  cursor: not-allowed;
+}
+
+@media (max-width: 900px) {
+  .topBarTrail {
+    display: none;
+  }
+
+  .mapControls {
+    right: 1.25rem;
+    bottom: calc(45vh + 1.35rem);
+  }
+}
